<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Prodigy - Responsive Landing Page</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, sans-serif;
}

html{
    scroll-behavior:smooth;
}

body{
    color:#17143a;
}

/* NAVBAR */
#navbar{
    position:fixed;
    top:0;
    left:0;
    width:100%;
    z-index:1000;
    padding:18px 8%;
    display:flex;
    justify-content:space-between;
    align-items:center;
    background:rgba(25,10,90,.35);
    backdrop-filter:blur(10px);
    transition:.4s;
}

#navbar.scrolled{
    background:#fff;
    box-shadow:0 3px 20px rgba(0,0,0,.15);
}

.logo{
    color:#fff;
    font-size:28px;
    font-weight:bold;
    text-decoration:none;
}

#navbar.scrolled .logo{
    color:#35129b;
}

.nav-menu{
    display:flex;
    gap:35px;
}

.nav-menu a{
    position:relative;
    color:#fff;
    text-decoration:none;
    font-weight:bold;
    padding:8px 0;
    transition:.3s;
}

.nav-menu a:hover{
    color:#ffd42a;
}

#navbar.scrolled .nav-menu a{
    color:#222;
}

#navbar.scrolled .nav-menu a:hover{
    color:#4d20d5;
}

.nav-menu a::after{
    content:"";
    position:absolute;
    bottom:0;
    left:0;
    width:0;
    height:3px;
    background:#ffd42a;
    transition:.3s;
}

.nav-menu a:hover::after,
.nav-menu a.active::after{
    width:100%;
}

.menu-btn{
    display:none;
    border:none;
    background:none;
    font-size:28px;
    cursor:pointer;
}

/* HERO */
.hero{
    min-height:100vh;
    padding:120px 8% 80px;
    display:flex;
    align-items:center;
    background:linear-gradient(135deg,#21006e,#4b18c7,#211184);
    color:#fff;
}

.hero-container{
    width:100%;
    max-width:1200px;
    margin:auto;
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:50px;
    align-items:center;
}

.small-title{
    color:#ffd42a;
    font-weight:bold;
    letter-spacing:2px;
    margin-bottom:15px;
}

.hero h1{
    font-size:65px;
    line-height:1.05;
    margin-bottom:25px;
}

.hero h1 span{
    display:block;
    color:#ffd42a;
}

.hero p{
    font-size:19px;
    line-height:1.7;
    margin-bottom:30px;
}

.buttons{
    display:flex;
    gap:15px;
}

.btn{
    display:inline-block;
    padding:15px 30px;
    border-radius:30px;
    text-decoration:none;
    font-weight:bold;
    transition:.3s;
}

.primary{
    background:#ffd42a;
    color:#111;
}

.primary:hover{
    transform:translateY(-4px);
    box-shadow:0 10px 25px rgba(255,212,42,.4);
}

.secondary{
    border:1px solid white;
    color:white;
}

.secondary:hover{
    background:white;
    color:#35129b;
}

/* LAPTOP */
.hero-image{
    display:flex;
    justify-content:center;
    align-items:center;
}

.laptop{
    width:450px;
    max-width:100%;
    padding:15px;
    background:#111;
    border-radius:18px;
    box-shadow:0 30px 50px rgba(0,0,0,.4);
    transform:rotate(-3deg);
}

.screen{
    height:270px;
    background:#15104a;
    border-radius:10px;
    padding:30px;
    border:4px solid #29245e;
}

.code{
    height:10px;
    margin:15px 0;
    border-radius:10px;
    background:#5dceff;
}

.code:nth-child(2){
    width:70%;
    background:#ff4fd8;
}

.code:nth-child(3){
    width:85%;
    background:#ffd42a;
}

.code:nth-child(4){
    width:55%;
    background:#64ff9c;
}

.code:nth-child(5){
    width:75%;
    background:#5dceff;
}

.base{
    width:115%;
    height:15px;
    margin-left:-7.5%;
    background:#777;
    border-radius:0 0 20px 20px;
}

/* COMMON SECTIONS */
section:not(.hero){
    scroll-margin-top:80px;
}

.section{
    padding:100px 8%;
}

.section-heading{
    text-align:center;
    margin-bottom:50px;
}

.section-heading h2,
.about h2,
.contact h2{
    font-size:45px;
    margin:10px 0;
}

.section-label{
    color:#5725df;
    font-weight:bold;
    letter-spacing:2px;
    font-size:13px;
}

/* ABOUT */
.about{
    background:#fff;
}

.about-container{
    max-width:1000px;
    margin:auto;
    display:flex;
    gap:30px;
    align-items:center;
}

.icon{
    min-width:100px;
    height:100px;
    border-radius:50%;
    background:#eee8ff;
    display:flex;
    justify-content:center;
    align-items:center;
    font-size:45px;
}

.about p:last-child{
    font-size:18px;
    line-height:1.7;
}

/* SERVICES */
.services{
    background:#f3f0ff;
}

.services-grid{
    max-width:1100px;
    margin:auto;
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:30px;
}

.card{
    background:#fff;
    padding:35px 25px;
    border-radius:15px;
    text-align:center;
    box-shadow:0 8px 25px rgba(50,20,120,.1);
    transition:.3s;
}

.card:hover{
    transform:translateY(-10px);
}

.service-icon{
    width:70px;
    height:70px;
    margin:0 auto 20px;
    border-radius:50%;
    background:#eee8ff;
    display:flex;
    justify-content:center;
    align-items:center;
    color:#5425df;
    font-size:28px;
    font-weight:bold;
}

.card h3{
    margin-bottom:15px;
}

.card p{
    color:#666;
    line-height:1.6;
}

/* PORTFOLIO */
.portfolio{
    background:#fff;
}

.portfolio-grid{
    max-width:1100px;
    margin:auto;
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:25px;
}

.project{
    height:230px;
    border-radius:15px;
    display:flex;
    align-items:flex-end;
    padding:25px;
    color:#fff;
    overflow:hidden;
    transition:.3s;
}

.project:hover{
    transform:scale(1.03);
}

.project h3{
    font-size:22px;
}

.project1{
    background:linear-gradient(135deg,#171052,#6943ff);
}

.project2{
    background:linear-gradient(135deg,#4015a8,#ff4fc3);
}

.project3{
    background:linear-gradient(135deg,#111,#315bff);
}

/* CONTACT */
.contact{
    background:#f3f0ff;
}

.contact-container{
    max-width:900px;
    margin:auto;
    text-align:center;
}

.contact-container p{
    font-size:18px;
}

.contact-container a{
    color:#5425df;
}

.social{
    display:flex;
    justify-content:center;
    gap:15px;
    margin-top:30px;
}

.social a{
    width:45px;
    height:45px;
    border-radius:50%;
    background:#5425df;
    color:white;
    display:flex;
    align-items:center;
    justify-content:center;
    font-weight:bold;
}

/* FOOTER */
footer{
    padding:25px;
    text-align:center;
    background:#15152f;
    color:#fff;
}

/* TOP BUTTON */
#topBtn{
    position:fixed;
    right:25px;
    bottom:25px;
    width:50px;
    height:50px;
    border:none;
    border-radius:50%;
    background:#5425df;
    color:#fff;
    font-size:25px;
    cursor:pointer;
    display:none;
}

/* RESPONSIVE */
@media(max-width:768px){

    #navbar{
        padding:15px 6%;
    }

    .menu-btn{
        display:block;
        color:white;
    }

    #navbar.scrolled .menu-btn{
        color:#222;
    }

    .nav-menu{
        position:absolute;
        top:70px;
        left:0;
        width:100%;
        background:#fff;
        display:none;
        flex-direction:column;
        align-items:center;
        padding:25px;
        gap:20px;
    }

    .nav-menu.show{
        display:flex;
    }

    .nav-menu a{
        color:#222 !important;
    }

    .hero-container{
        grid-template-columns:1fr;
        text-align:center;
    }

    .hero h1{
        font-size:45px;
    }

    .hero-description{
        font-size:16px;
    }

    .buttons{
        justify-content:center;
    }

    .hero-image{
        margin-top:30px;
    }

    .laptop{
        width:350px;
    }

    .services-grid,
    .portfolio-grid{
        grid-template-columns:1fr;
    }

    .about-container{
        flex-direction:column;
        text-align:center;
    }

    .section-heading h2,
    .about h2,
    .contact h2{
        font-size:35px;
    }
}
</style>
</head>

<body>

<!-- NAVIGATION -->
<header id="navbar">
    <a href="#home" class="logo">Prodigy</a>

    <nav class="nav-menu" id="navMenu">
        <a href="#home" class="nav-link active">Home</a>
        <a href="#about" class="nav-link">About</a>
        <a href="#services" class="nav-link">Services</a>
        <a href="#portfolio" class="nav-link">Portfolio</a>
        <a href="#contact" class="nav-link">Contact</a>
    </nav>

    <button class="menu-btn" id="menuBtn">☰</button>
</header>


<!-- HERO -->
<section class="hero" id="home">

    <div class="hero-container">

        <div>
            <div class="small-title">WELCOME TO PRODIGY</div>

            <h1>
                Responsive
                <span>Landing Page</span>
            </h1>

            <p>
                Interactive Navigation Menu using HTML,
                CSS & JavaScript.
            </p>

            <div class="buttons">
                <a href="#about" class="btn primary">
                    Explore More →
                </a>

                <a href="#contact" class="btn secondary">
                    Contact Us
                </a>
            </div>
        </div>

        <div class="hero-image">

            <div class="laptop">

                <div class="screen">
                    <div class="code"></div>
                    <div class="code"></div>
                    <div class="code"></div>
                    <div class="code"></div>
                    <div class="code"></div>
                </div>

                <div class="base"></div>

            </div>

        </div>

    </div>

</section>


<!-- ABOUT -->
<section class="section about" id="about">

    <div class="about-container">

        <div class="icon">👤</div>

        <div>
            <div class="section-label">WHO WE ARE</div>

            <h2>About</h2>

            <p>
                This landing page demonstrates a fixed
                navigation bar that changes color while
                scrolling and provides hover effects.
            </p>
        </div>

    </div>

</section>


<!-- SERVICES -->
<section class="section services" id="services">

    <div class="section-heading">

        <div class="section-label">WHAT WE DO</div>

        <h2>Services</h2>

        <p>
            Modern solutions for modern businesses.
        </p>

    </div>

    <div class="services-grid">

        <div class="card">

            <div class="service-icon">
                &lt;/&gt;
            </div>

            <h3>Web Development</h3>

            <p>
                Modern websites built with clean
                and efficient technologies.
            </p>

        </div>


        <div class="card">

            <div class="service-icon">
                🎨
            </div>

            <h3>UI Design</h3>

            <p>
                Beautiful and intuitive user interfaces
                designed for great experiences.
            </p>

        </div>


        <div class="card">

            <div class="service-icon">
                📱
            </div>

            <h3>Responsive Websites</h3>

            <p>
                Websites that work perfectly on
                desktop, tablet and mobile.
            </p>

        </div>

    </div>

</section>


<!-- PORTFOLIO -->
<section class="section portfolio" id="portfolio">

    <div class="section-heading">

        <div class="section-label">OUR WORK</div>

        <h2>Portfolio</h2>

        <p>
            Showcase your projects here.
        </p>

    </div>

    <div class="portfolio-grid">

        <div class="project project1">
            <h3>Web Development</h3>
        </div>

        <div class="project project2">
            <h3>Dashboard UI</h3>
        </div>

        <div class="project project3">
            <h3>Mobile Design</h3>
        </div>

    </div>

</section>


<!-- CONTACT -->
<section class="section contact" id="contact">

    <div class="contact-container">

        <div class="section-label">GET IN TOUCH</div>

        <h2>Contact</h2>

        <p>
            Email:
            <a href="mailto:example@email.com">
                example@email.com
            </a>
        </p>

        <div class="social">

            <a href="#">𝕏</a>
            <a href="#">in</a>
            <a href="#">●</a>
            <a href="#">◎</a>

        </div>

    </div>

</section>


<!-- FOOTER -->
<footer>
    <p>
        © 2026 Prodigy Infotech. All Rights Reserved.
    </p>
</footer>


<!-- BACK TO TOP -->
<button id="topBtn">↑</button>


<script>

/* =========================
   NAVBAR SCROLL EFFECT
========================= */

const navbar = document.getElementById("navbar");
const topBtn = document.getElementById("topBtn");

window.addEventListener("scroll", function(){

    if(window.scrollY > 80){

        navbar.classList.add("scrolled");
        topBtn.style.display = "block";

    }else{

        navbar.classList.remove("scrolled");
        topBtn.style.display = "none";

    }

});


/* =========================
   ACTIVE NAVIGATION
========================= */

const sections = document.querySelectorAll("section");
const navLinks = document.querySelectorAll(".nav-link");

window.addEventListener("scroll", function(){

    let current = "";

    sections.forEach(section => {

        const sectionTop = section.offsetTop - 150;

        if(window.scrollY >= sectionTop){

            current = section.getAttribute("id");

        }

    });

    navLinks.forEach(link => {

        link.classList.remove("active");

        if(link.getAttribute("href") === "#" + current){

            link.classList.add("active");

        }

    });

});


/* =========================
   MOBILE MENU
========================= */

const menuBtn = document.getElementById("menuBtn");
const navMenu = document.getElementById("navMenu");

menuBtn.addEventListener("click", function(){

    navMenu.classList.toggle("show");

});


/* Close menu after clicking */

navLinks.forEach(link => {

    link.addEventListener("click", function(){

        navMenu.classList.remove("show");

    });

});


/* =========================
   BACK TO TOP
========================= */

topBtn.addEventListener("click", function(){

    window.scrollTo({

        top:0,
        behavior:"smooth"

    });

});

</script>

</body>
</html>
