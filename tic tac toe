<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tic-Tac-Toe | Prodigy Infotech</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    min-height:100vh;
    font-family:Arial,Helvetica,sans-serif;
    background:
        radial-gradient(circle at 20% 20%,#4120a0 0%,transparent 30%),
        radial-gradient(circle at 85% 80%,#176dcc 0%,transparent 35%),
        linear-gradient(135deg,#17074b,#25116d,#092f72);
    color:white;
    display:flex;
    justify-content:center;
    align-items:center;
    padding:30px 15px;
}

.container{
    width:100%;
    max-width:1050px;
    text-align:center;
}

/* HEADER */

.logo{
    font-size:15px;
    letter-spacing:3px;
    color:#63e6ff;
    font-weight:bold;
    margin-bottom:12px;
}

h1{
    font-size:52px;
    margin-bottom:10px;
}

.subtitle{
    color:#d5d9f2;
    font-size:17px;
    margin-bottom:30px;
}

/* GAME MODE */

.mode-buttons{
    display:flex;
    justify-content:center;
    gap:12px;
    margin-bottom:25px;
}

.mode-btn{
    padding:12px 22px;
    border:1px solid rgba(255,255,255,.3);
    background:rgba(255,255,255,.08);
    color:white;
    border-radius:10px;
    cursor:pointer;
    font-weight:bold;
    transition:.3s;
}

.mode-btn:hover,
.mode-btn.active{
    background:#4c8dff;
    border-color:#4c8dff;
}

/* SCORE */

.scoreboard{
    display:flex;
    justify-content:center;
    gap:20px;
    margin-bottom:25px;
}

.score{
    min-width:120px;
    padding:15px 25px;
    background:rgba(255,255,255,.08);
    border:1px solid rgba(255,255,255,.12);
    border-radius:14px;
    backdrop-filter:blur(10px);
}

.score span{
    display:block;
    color:#cbd3f2;
    font-size:13px;
    margin-bottom:7px;
}

.score strong{
    font-size:28px;
}

.x-score strong{
    color:#5ee7ff;
}

.o-score strong{
    color:#ff77e8;
}

/* GAME */

.game-wrapper{
    display:flex;
    justify-content:center;
    align-items:center;
    gap:60px;
}

.game-card{
    background:rgba(255,255,255,.09);
    padding:28px;
    border-radius:25px;
    border:1px solid rgba(255,255,255,.15);
    box-shadow:0 25px 60px rgba(0,0,0,.3);
    backdrop-filter:blur(15px);
}

/* BOARD */

.board{
    width:360px;
    height:360px;
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:10px;
}

.cell{
    border:none;
    border-radius:16px;
    background:rgba(10,20,65,.75);
    color:white;
    font-size:65px;
    font-weight:bold;
    cursor:pointer;
    transition:.25s;
    box-shadow:inset 0 0 0 1px rgba(255,255,255,.08);
}

.cell:hover{
    background:rgba(70,105,200,.7);
    transform:scale(.97);
}

.cell.x{
    color:#5ee7ff;
}

.cell.o{
    color:#ff77e8;
}

.cell.winner{
    background:#20c997;
    color:white;
    animation:pulse .7s infinite alternate;
}

@keyframes pulse{
    from{
        transform:scale(1);
    }
    to{
        transform:scale(.95);
    }
}

/* SIDE */

.game-info{
    width:260px;
    text-align:left;
}

.status-box{
    background:rgba(255,255,255,.08);
    border:1px solid rgba(255,255,255,.12);
    border-radius:18px;
    padding:25px;
    margin-bottom:20px;
}

.status-title{
    color:#9da9d5;
    font-size:13px;
    text-transform:uppercase;
    letter-spacing:1px;
    margin-bottom:10px;
}

#status{
    font-size:22px;
    font-weight:bold;
}

.restart{
    width:100%;
    border:none;
    padding:15px;
    border-radius:12px;
    background:linear-gradient(90deg,#536dfe,#7b4dff);
    color:white;
    font-size:16px;
    font-weight:bold;
    cursor:pointer;
    transition:.3s;
}

.restart:hover{
    transform:translateY(-3px);
    box-shadow:0 10px 25px rgba(80,100,255,.4);
}

.rules{
    margin-top:20px;
    color:#bfc7e5;
    font-size:13px;
    line-height:1.7;
}

/* FOOTER */

footer{
    margin-top:35px;
    color:#929cc3;
    font-size:13px;
}

footer span{
    color:#5ee7ff;
}

/* RESPONSIVE */

@media(max-width:800px){

    h1{
        font-size:40px;
    }

    .game-wrapper{
        flex-direction:column;
        gap:25px;
    }

    .game-info{
        width:360px;
        max-width:100%;
    }

}

@media(max-width:450px){

    body{
        padding:20px 10px;
    }

    h1{
        font-size:32px;
    }

    .subtitle{
        font-size:14px;
    }

    .mode-buttons{
        flex-wrap:wrap;
    }

    .scoreboard{
        gap:8px;
    }

    .score{
        min-width:95px;
        padding:12px;
    }

    .board{
        width:290px;
        height:290px;
    }

    .game-card{
        padding:18px;
    }

    .cell{
        font-size:50px;
    }

    .game-info{
        width:290px;
    }
}
</style>
</head>

<body>

<div class="container">

    <div class="logo">PRODIGY INFOTECH</div>

    <h1>Tic-Tac-Toe</h1>

    <p class="subtitle">
        A modern interactive game built with HTML, CSS & JavaScript
    </p>

    <!-- GAME MODES -->

    <div class="mode-buttons">

        <button class="mode-btn active" id="pvpBtn">
            👥 Player vs Player
        </button>

        <button class="mode-btn" id="aiBtn">
            🤖 Player vs AI
        </button>

    </div>

    <!-- SCOREBOARD -->

    <div class="scoreboard">

        <div class="score x-score">
            <span>PLAYER X</span>
            <strong id="xScore">0</strong>
        </div>

        <div class="score">
            <span>DRAWS</span>
            <strong id="drawScore">0</strong>
        </div>

        <div class="score o-score">
            <span id="oLabel">PLAYER O</span>
            <strong id="oScore">0</strong>
        </div>

    </div>

    <!-- GAME -->

    <div class="game-wrapper">

        <div class="game-card">

            <div class="board" id="board">

                <button class="cell" data-index="0"></button>
                <button class="cell" data-index="1"></button>
                <button class="cell" data-index="2"></button>

                <button class="cell" data-index="3"></button>
                <button class="cell" data-index="4"></button>
                <button class="cell" data-index="5"></button>

                <button class="cell" data-index="6"></button>
                <button class="cell" data-index="7"></button>
                <button class="cell" data-index="8"></button>

            </div>

        </div>

        <!-- INFO -->

        <div class="game-info">

            <div class="status-box">

                <div class="status-title">
                    Game Status
                </div>

                <div id="status">
                    Player X's Turn
                </div>

            </div>

            <button class="restart" id="restartBtn">
                🔄 Restart Game
            </button>

            <div class="rules">

                <strong>How to play:</strong><br>

                Get three of your symbols in a row,
                column, or diagonal to win the game.

                <br><br>

                X always plays first.

            </div>

        </div>

    </div>

    <footer>
        Built with ❤️ using
        <span>HTML • CSS • JavaScript</span>
        | Prodigy Infotech Internship
    </footer>

</div>


<script>

/* =========================================
   VARIABLES
========================================= */

const cells =
document.querySelectorAll(".cell");

const statusText =
document.getElementById("status");

const restartBtn =
document.getElementById("restartBtn");

const pvpBtn =
document.getElementById("pvpBtn");

const aiBtn =
document.getElementById("aiBtn");

const xScoreElement =
document.getElementById("xScore");

const oScoreElement =
document.getElementById("oScore");

const drawScoreElement =
document.getElementById("drawScore");

const oLabel =
document.getElementById("oLabel");


let board =
["","","","","","","","",""];

let currentPlayer = "X";

let gameActive = true;

let vsAI = false;

let xScore = 0;

let oScore = 0;

let drawScore = 0;


/* =========================================
   WINNING COMBINATIONS
========================================= */

const winningPatterns = [

    [0,1,2],
    [3,4,5],
    [6,7,8],

    [0,3,6],
    [1,4,7],
    [2,5,8],

    [0,4,8],
    [2,4,6]

];


/* =========================================
   CELL CLICK
========================================= */

cells.forEach(cell => {

    cell.addEventListener("click", () => {

        const index =
        cell.getAttribute("data-index");

        if(
            board[index] !== "" ||
            !gameActive
        ){

            return;

        }

        makeMove(index,currentPlayer);

        if(
            gameActive &&
            vsAI &&
            currentPlayer === "O"
        ){

            setTimeout(aiMove,400);

        }

    });

});


/* =========================================
   MAKE MOVE
========================================= */

function makeMove(index,player){

    board[index] = player;

    cells[index].textContent = player;

    cells[index].classList.add(
        player.toLowerCase()
    );

    checkGame();

}


/* =========================================
   CHECK GAME
========================================= */

function checkGame(){

    let winner = null;

    let winningCells = null;


    for(
        let pattern of winningPatterns
    ){

        const [a,b,c] = pattern;

        if(

            board[a] !== "" &&

            board[a] === board[b] &&

            board[a] === board[c]

        ){

            winner = board[a];

            winningCells = pattern;

            break;

        }

    }


    if(winner){

        gameActive = false;

        winningCells.forEach(index => {

            cells[index].classList.add(
                "winner"
            );

        });


        statusText.textContent =
        `🎉 Player ${winner} Wins!`;


        if(winner === "X"){

            xScore++;

            xScoreElement.textContent =
            xScore;

        }

        else{

            oScore++;

            oScoreElement.textContent =
            oScore;

        }

        return;

    }


    if(!board.includes("")){

        gameActive = false;

        drawScore++;

        drawScoreElement.textContent =
        drawScore;

        statusText.textContent =
        "🤝 It's a Draw!";

        return;

    }


    currentPlayer =
    currentPlayer === "X"
    ?
    "O"
    :
    "X";


    if(vsAI && currentPlayer === "O"){

        statusText.textContent =
        "🤖 AI is thinking...";

    }

    else{

        statusText.textContent =
        `Player ${currentPlayer}'s Turn`;

    }

}


/* =========================================
   AI MOVE
========================================= */

function aiMove(){

    if(!gameActive){

        return;

    }


    let bestMove =
    findBestMove();


    makeMove(
        bestMove,
        "O"
    );

}


/* =========================================
   AI STRATEGY
========================================= */

function findBestMove(){

    /* Try to win */

    for(let i=0;i<9;i++){

        if(board[i] === ""){

            board[i] = "O";

            if(checkWinnerForAI("O")){

                board[i] = "";

                return i;

            }

            board[i] = "";

        }

    }


    /* Block player */

    for(let i=0;i<9;i++){

        if(board[i] === ""){

            board[i] = "X";

            if(checkWinnerForAI("X")){

                board[i] = "";

                return i;

            }

            board[i] = "";

        }

    }


    /* Take center */

    if(board[4] === ""){

        return 4;

    }


    /* Take corner */

    const corners =
    [0,2,6,8];

    const availableCorners =
    corners.filter(
        i => board[i] === ""
    );


    if(availableCorners.length){

        return availableCorners[
            Math.floor(
                Math.random() *
                availableCorners.length
            )
        ];

    }


    /* Take any available */

    const available =
    board
    .map(
        (value,index) =>
        value === ""
        ?
        index
        :
        null
    )
    .filter(
        value => value !== null
    );


    return available[
        Math.floor(
            Math.random() *
            available.length
        )
    ];

}


/* =========================================
   AI WIN CHECK
========================================= */

function checkWinnerForAI(player){

    return winningPatterns.some(
        pattern => {

            const [a,b,c] =
            pattern;

            return (

                board[a] === player &&

                board[b] === player &&

                board[c] === player

            );

        }
    );

}


/* =========================================
   RESTART
========================================= */

restartBtn.addEventListener(
    "click",
    restartGame
);


function restartGame(){

    board =
    ["","","","","","","","",""];

    currentPlayer = "X";

    gameActive = true;


    cells.forEach(cell => {

        cell.textContent = "";

        cell.classList.remove(
            "x",
            "o",
            "winner"
        );

    });


    statusText.textContent =
    "Player X's Turn";

}


/* =========================================
   PLAYER VS PLAYER
========================================= */

pvpBtn.addEventListener(
    "click",
    () => {

        vsAI = false;

        pvpBtn.classList.add(
            "active"
        );

        aiBtn.classList.remove(
            "active"
        );

        oLabel.textContent =
        "PLAYER O";

        restartGame();

    }
);


/* =========================================
   PLAYER VS AI
========================================= */

aiBtn.addEventListener(
    "click",
    () => {

        vsAI = true;

        aiBtn.classList.add(
            "active"
        );

        pvpBtn.classList.remove(
            "active"
        );

        oLabel.textContent =
        "AI 🤖";

        restartGame();

    }
);

</script>

</body>
</html>