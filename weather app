<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Weather App | Prodigy Infotech</title>

<style>

/* =====================================================
   RESET
===================================================== */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{

    font-family:Arial, Helvetica, sans-serif;

    min-height:100vh;

    color:white;

    background:
    radial-gradient(circle at 85% 10%,#283c9b 0%,transparent 30%),
    radial-gradient(circle at 10% 55%,#183e7d 0%,transparent 35%),
    linear-gradient(135deg,#061b3f,#07185a,#11175c);

}


/* =====================================================
   HEADER
===================================================== */

header{

    height:80px;

    padding:0 4%;

    display:flex;

    align-items:center;

    justify-content:space-between;

    background:rgba(2,12,40,.55);

    border-bottom:1px solid rgba(255,255,255,.08);

    backdrop-filter:blur(12px);

}

.logo{

    display:flex;

    align-items:center;

    gap:12px;

    font-size:26px;

    font-weight:700;

}

.logo-icon{

    font-size:34px;

}

.location-status{

    display:flex;

    align-items:center;

    gap:8px;

    color:#fff;

    font-size:16px;

}

.location-dot{

    color:#4285ff;

    font-size:25px;

}


/* =====================================================
   MAIN
===================================================== */

main{

    width:92%;

    max-width:1300px;

    margin:auto;

    padding:35px 0 50px;

}


/* =====================================================
   SEARCH AREA
===================================================== */

.search-area{

    text-align:center;

    margin-bottom:30px;

}

.search-area h1{

    font-size:38px;

    margin-bottom:12px;

}

.search-area > p{

    color:#d4dcf5;

    margin-bottom:25px;

    font-size:17px;

}

.search-box{

    width:min(700px,100%);

    margin:auto;

    display:flex;

    background:white;

    border-radius:14px;

    overflow:hidden;

    box-shadow:0 15px 35px rgba(0,0,0,.25);

}

.search-box input{

    flex:1;

    border:none;

    outline:none;

    padding:18px 20px;

    font-size:16px;

    color:#222;

}

.search-box button{

    border:none;

    padding:0 35px;

    background:#3475ff;

    color:white;

    font-size:16px;

    font-weight:bold;

    cursor:pointer;

    transition:.3s;

}

.search-box button:hover{

    background:#205de0;

}

.or{

    margin:15px 0;

    color:#d1d8f1;

}

.location-btn{

    border:none;

    background:#3475ff;

    color:white;

    padding:14px 25px;

    border-radius:10px;

    font-size:15px;

    font-weight:bold;

    cursor:pointer;

    transition:.3s;

}

.location-btn:hover{

    transform:translateY(-2px);

    background:#205de0;

}


/* =====================================================
   LOADING
===================================================== */

.loading{

    text-align:center;

    padding:30px;

    display:none;

}

.spinner{

    width:35px;

    height:35px;

    border:4px solid rgba(255,255,255,.3);

    border-top-color:white;

    border-radius:50%;

    animation:spin 1s linear infinite;

    margin:auto auto 12px;

}

@keyframes spin{

    to{
        transform:rotate(360deg);
    }

}


/* =====================================================
   ERROR
===================================================== */

.error{

    display:none;

    text-align:center;

    background:rgba(255,70,70,.15);

    border:1px solid rgba(255,100,100,.3);

    padding:15px;

    border-radius:10px;

    margin:20px auto;

    max-width:700px;

}


/* =====================================================
   CURRENT WEATHER
===================================================== */

.weather-card{

    background:
    linear-gradient(
        110deg,
        rgba(51,123,220,.9),
        rgba(55,95,205,.75)
    );

    border-radius:16px;

    padding:32px;

    margin-top:25px;

    box-shadow:0 15px 40px rgba(0,0,0,.25);

    display:none;

}

.weather-top{

    display:flex;

    justify-content:space-between;

    align-items:center;

    gap:30px;

}

.city{

    font-size:26px;

    font-weight:bold;

}

.date{

    margin-top:8px;

    color:#dbe7ff;

}

.current{

    margin-top:30px;

    display:flex;

    align-items:center;

    gap:25px;

}

.weather-icon{

    font-size:85px;

}

.temperature{

    font-size:80px;

    font-weight:bold;

    line-height:1;

}

.condition{

    font-size:24px;

    font-weight:bold;

    margin-top:10px;

}

.feels{

    margin-top:8px;

    color:#dce7ff;

}


/* WEATHER DETAILS */

.details{

    display:grid;

    grid-template-columns:repeat(4,1fr);

    gap:20px;

    border-left:1px solid rgba(255,255,255,.25);

    padding-left:35px;

}

.detail{

    display:flex;

    align-items:center;

    gap:10px;

}

.detail-icon{

    font-size:25px;

}

.detail-name{

    color:#dce7ff;

    font-size:14px;

}

.detail-value{

    font-weight:bold;

    margin-top:4px;

}


/* =====================================================
   LOWER GRID
===================================================== */

.lower-grid{

    display:grid;

    grid-template-columns:2fr 1fr;

    gap:20px;

    margin-top:20px;

}


/* =====================================================
   FORECAST
===================================================== */

.forecast-card,
.aqi-card{

    background:rgba(30,48,115,.65);

    border:1px solid rgba(255,255,255,.08);

    border-radius:15px;

    padding:25px;

}

.card-title{

    font-size:22px;

    margin-bottom:20px;

}

.forecast-grid{

    display:grid;

    grid-template-columns:repeat(5,1fr);

    gap:10px;

}

.forecast-item{

    background:rgba(60,90,165,.35);

    border-radius:12px;

    padding:18px 10px;

    text-align:center;

}

.forecast-day{

    font-weight:bold;

    margin-bottom:12px;

}

.forecast-icon{

    font-size:38px;

    margin:10px 0;

}

.max-temp{

    font-weight:bold;

    font-size:17px;

}

.min-temp{

    color:#8fb8ff;

    margin-top:7px;

}


/* =====================================================
   AQI
===================================================== */

.aqi-number{

    text-align:center;

    font-size:45px;

    font-weight:bold;

    color:#57e65d;

    margin:20px 0 5px;

}

.aqi-status{

    text-align:center;

    font-size:18px;

    font-weight:bold;

    margin-bottom:20px;

}

.aqi-bar{

    height:13px;

    width:100%;

    border-radius:20px;

    background:

    linear-gradient(
        90deg,
        #19d84c,
        #d9e800,
        #ffb300,
        #ff5200,
        #ff2222
    );

    position:relative;

}

.aqi-marker{

    position:absolute;

    top:50%;

    left:25%;

    width:16px;

    height:16px;

    background:white;

    border-radius:50%;

    transform:translate(-50%,-50%);

    box-shadow:0 2px 5px rgba(0,0,0,.4);

}

.aqi-scale{

    display:flex;

    justify-content:space-between;

    margin-top:8px;

    color:#c8d4f5;

    font-size:12px;

}


/* =====================================================
   FOOTER
===================================================== */

footer{

    padding:25px 4%;

    background:rgba(1,10,32,.7);

    display:flex;

    justify-content:space-between;

    color:#b9c4df;

    font-size:14px;

}

footer a{

    color:#5790ff;

    text-decoration:none;

}


/* =====================================================
   RESPONSIVE
===================================================== */

@media(max-width:900px){

    .weather-top{

        flex-direction:column;

        align-items:flex-start;

    }

    .details{

        border-left:none;

        border-top:1px solid rgba(255,255,255,.25);

        padding-left:0;

        padding-top:25px;

        width:100%;

    }

    .lower-grid{

        grid-template-columns:1fr;

    }

}


@media(max-width:650px){

    header{

        height:auto;

        padding:15px 5%;

        gap:10px;

        flex-direction:column;

    }

    .logo{

        font-size:22px;

    }

    .location-status{

        font-size:13px;

    }

    main{

        width:94%;

        padding-top:25px;

    }

    .search-area h1{

        font-size:28px;

    }

    .search-area > p{

        font-size:14px;

    }

    .search-box{

        flex-direction:column;

    }

    .search-box input{

        padding:16px;

    }

    .search-box button{

        padding:15px;

    }

    .weather-card{

        padding:20px;

    }

    .current{

        flex-direction:column;

        align-items:flex-start;

    }

    .temperature{

        font-size:60px;

    }

    .weather-icon{

        font-size:65px;

    }

    .details{

        grid-template-columns:1fr 1fr;

    }

    .forecast-grid{

        grid-template-columns:1fr;

    }

    .forecast-item{

        display:flex;

        justify-content:space-between;

        align-items:center;

        padding:15px;

    }

    .forecast-icon{

        margin:0;

    }

    footer{

        flex-direction:column;

        gap:10px;

        text-align:center;

    }

}

</style>

</head>


<body>


<!-- =====================================================
     HEADER
===================================================== -->

<header>

    <div class="logo">

        <span class="logo-icon">🌤️</span>

        Weather App

    </div>


    <div class="location-status">

        <span class="location-dot">📍</span>

        <span id="locationStatus">
            Detecting your location...
        </span>

    </div>

</header>



<!-- =====================================================
     MAIN
===================================================== -->

<main>


<!-- SEARCH -->

<section class="search-area">

    <h1>
        Get Real-Time Weather
    </h1>

    <p>
        Enter a city name or allow location access
        to get weather updates.
    </p>


    <div class="search-box">

        <input
            type="text"
            id="cityInput"
            placeholder="Enter city name..."
        >

        <button id="searchBtn">
            Search
        </button>

    </div>


    <div class="or">
        ───────── &nbsp; or &nbsp; ─────────
    </div>


    <button class="location-btn" id="locationBtn">

        📍 Use My Location

    </button>

</section>



<!-- LOADING -->

<div class="loading" id="loading">

    <div class="spinner"></div>

    <p>
        Getting weather data...
    </p>

</div>



<!-- ERROR -->

<div class="error" id="error">

    Something went wrong. Please try again.

</div>



<!-- =====================================================
     WEATHER CARD
===================================================== -->

<section class="weather-card" id="weatherCard">


    <div class="weather-top">


        <div>

            <div class="city" id="cityName">
                New Delhi, IN
            </div>

            <div class="date" id="date">
                Today
            </div>


            <div class="current">

                <div class="weather-icon" id="weatherIcon">
                    ☀️
                </div>

                <div>

                    <div class="temperature">

                        <span id="temperature">
                            --°
                        </span>

                    </div>

                    <div class="condition" id="condition">
                        Clear Sky
                    </div>

                    <div class="feels">

                        Feels like
                        <span id="feelsLike">
                            --°C
                        </span>

                    </div>

                </div>

            </div>

        </div>



        <!-- DETAILS -->

        <div class="details">


            <div class="detail">

                <div class="detail-icon">
                    💧
                </div>

                <div>

                    <div class="detail-name">
                        Humidity
                    </div>

                    <div class="detail-value">
                        <span id="humidity">--</span>%
                    </div>

                </div>

            </div>


            <div class="detail">

                <div class="detail-icon">
                    💨
                </div>

                <div>

                    <div class="detail-name">
                        Wind Speed
                    </div>

                    <div class="detail-value">
                        <span id="wind">--</span> km/h
                    </div>

                </div>

            </div>


            <div class="detail">

                <div class="detail-icon">
                    🧭
                </div>

                <div>

                    <div class="detail-name">
                        Pressure
                    </div>

                    <div class="detail-value">
                        <span id="pressure">--</span> hPa
                    </div>

                </div>

            </div>


            <div class="detail">

                <div class="detail-icon">
                    👁️
                </div>

                <div>

                    <div class="detail-name">
                        Visibility
                    </div>

                    <div class="detail-value">
                        <span id="visibility">--</span> km
                    </div>

                </div>

            </div>


        </div>

    </div>

</section>



<!-- =====================================================
     FORECAST + AQI
===================================================== -->

<div class="lower-grid" id="lowerGrid" style="display:none;">


    <!-- FORECAST -->

    <section class="forecast-card">

        <h2 class="card-title">
            5-Day Forecast
        </h2>

        <div
            class="forecast-grid"
            id="forecastGrid"
        ></div>

    </section>



    <!-- AQI -->

    <section class="aqi-card">

        <h2 class="card-title">
            Air Quality Index
        </h2>

        <div class="aqi-number" id="aqiNumber">
            --
        </div>

        <div class="aqi-status" id="aqiStatus">
            --
        </div>

        <div class="aqi-bar">

            <div
                class="aqi-marker"
                id="aqiMarker"
            ></div>

        </div>

        <div class="aqi-scale">

            <span>0</span>
            <span>50</span>
            <span>100</span>
            <span>150</span>
            <span>200</span>
            <span>300</span>

        </div>

    </section>


</div>

</main>



<!-- =====================================================
     FOOTER
===================================================== -->

<footer>

    <div>

        Data provided by

        <a
            href="https://open-meteo.com/"
            target="_blank"
        >
            Open-Meteo API
        </a>

    </div>


    <div>

        Made with ❤️ by Prodigy Infotech

    </div>

</footer>



<script>

/* =====================================================
   API URLs
===================================================== */

const GEO_API =
"https://geocoding-api.open-meteo.com/v1/search";

const WEATHER_API =
"https://api.open-meteo.com/v1/forecast";

const AIR_API =
"https://air-quality-api.open-meteo.com/v1/air-quality";



/* =====================================================
   ELEMENTS
===================================================== */

const cityInput =
document.getElementById("cityInput");

const searchBtn =
document.getElementById("searchBtn");

const locationBtn =
document.getElementById("locationBtn");

const weatherCard =
document.getElementById("weatherCard");

const lowerGrid =
document.getElementById("lowerGrid");

const loading =
document.getElementById("loading");

const errorBox =
document.getElementById("error");

const locationStatus =
document.getElementById("locationStatus");



/* =====================================================
   WEATHER CODE
===================================================== */

function getWeatherInfo(code){

    const weather = {

        0: ["Clear Sky","☀️"],

        1: ["Mainly Clear","🌤️"],

        2: ["Partly Cloudy","⛅"],

        3: ["Overcast","☁️"],

        45: ["Fog","🌫️"],

        48: ["Rime Fog","🌫️"],

        51: ["Light Drizzle","🌦️"],

        53: ["Drizzle","🌦️"],

        55: ["Heavy Drizzle","🌧️"],

        61: ["Light Rain","🌦️"],

        63: ["Rain","🌧️"],

        65: ["Heavy Rain","🌧️"],

        71: ["Light Snow","🌨️"],

        73: ["Snow","❄️"],

        75: ["Heavy Snow","❄️"],

        80: ["Rain Showers","🌦️"],

        81: ["Rain Showers","🌧️"],

        82: ["Heavy Rain Showers","⛈️"],

        95: ["Thunderstorm","⛈️"],

        96: ["Thunderstorm + Hail","⛈️"],

        99: ["Thunderstorm + Hail","⛈️"]

    };

    return weather[code] || ["Unknown","🌤️"];

}



/* =====================================================
   FORMAT DATE
===================================================== */

function formatDate(dateString){

    const date =
    new Date(dateString);

    return date.toLocaleDateString(
        "en-IN",
        {
            weekday:"long",
            day:"numeric",
            month:"long",
            year:"numeric"
        }
    );

}



/* =====================================================
   GET CITY COORDINATES
===================================================== */

async function searchCity(city){

    const response =
    await fetch(
        `${GEO_API}?name=${encodeURIComponent(city)}&count=1&language=en&format=json`
    );

    if(!response.ok){

        throw new Error("Location search failed");

    }

    const data =
    await response.json();

    if(!data.results || data.results.length === 0){

        throw new Error(
            "City not found. Please enter a valid city."
        );

    }

    return data.results[0];

}



/* =====================================================
   GET WEATHER
===================================================== */

async function getWeather(
    latitude,
    longitude,
    locationName,
    country
){

    showLoading(true);

    try{

        const weatherURL =

        `${WEATHER_API}?latitude=${latitude}` +
        `&longitude=${longitude}` +
        `&current=temperature_2m,relative_humidity_2m,apparent_temperature,weather_code,surface_pressure,wind_speed_10m,visibility` +
        `&daily=weather_code,temperature_2m_max,temperature_2m_min` +
        `&timezone=auto` +
        `&forecast_days=5`;


        const response =
        await fetch(weatherURL);


        if(!response.ok){

            throw new Error(
                "Weather data unavailable"
            );

        }


        const data =
        await response.json();


        displayWeather(
            data,
            locationName,
            country
        );


        await getAirQuality(
            latitude,
            longitude
        );


        locationStatus.textContent =
        `${locationName}, ${country}`;


    }

    catch(err){

        showError(err.message);

    }

    finally{

        showLoading(false);

    }

}



/* =====================================================
   DISPLAY WEATHER
===================================================== */

function displayWeather(
    data,
    locationName,
    country
){

    const current =
    data.current;


    document.getElementById("cityName")
    .textContent =
    `${locationName}, ${country}`;


    document.getElementById("date")
    .textContent =
    formatDate(current.time);


    document.getElementById("temperature")
    .textContent =
    `${Math.round(current.temperature_2m)}°C`;


    document.getElementById("feelsLike")
    .textContent =
    `${Math.round(current.apparent_temperature)}°C`;


    document.getElementById("humidity")
    .textContent =
    Math.round(current.relative_humidity_2m);


    document.getElementById("wind")
    .textContent =
    Math.round(current.wind_speed_10m);


    document.getElementById("pressure")
    .textContent =
    Math.round(current.surface_pressure);


    document.getElementById("visibility")
    .textContent =
    (current.visibility / 1000).toFixed(1);


    const info =
    getWeatherInfo(
        current.weather_code
    );


    document.getElementById("condition")
    .textContent =
    info[0];


    document.getElementById("weatherIcon")
    .textContent =
    info[1];


    displayForecast(
        data.daily
    );


    weatherCard.style.display =
    "block";

    lowerGrid.style.display =
    "grid";

}



/* =====================================================
   FORECAST
===================================================== */

function displayForecast(daily){

    const forecastGrid =
    document.getElementById("forecastGrid");


    forecastGrid.innerHTML = "";


    for(let i=0;i<5;i++){

        const date =
        new Date(
            daily.time[i]
        );


        const day =
        date.toLocaleDateString(
            "en-IN",
            {
                weekday:"short"
            }
        );


        const info =
        getWeatherInfo(
            daily.weather_code[i]
        );


        const item =
        document.createElement("div");


        item.className =
        "forecast-item";


        item.innerHTML = `

            <div class="forecast-day">
                ${day}
            </div>

            <div class="forecast-icon">
                ${info[1]}
            </div>

            <div class="max-temp">
                ${Math.round(
                    daily.temperature_2m_max[i]
                )}°C
            </div>

            <div class="min-temp">
                ${Math.round(
                    daily.temperature_2m_min[i]
                )}°C
            </div>

        `;


        forecastGrid.appendChild(item);

    }

}



/* =====================================================
   AIR QUALITY
===================================================== */

async function getAirQuality(
    latitude,
    longitude
){

    try{

        const url =

        `${AIR_API}?latitude=${latitude}` +
        `&longitude=${longitude}` +
        `&current=us_aqi` +
        `&timezone=auto`;


        const response =
        await fetch(url);


        if(!response.ok){

            return;

        }


        const data =
        await response.json();


        if(
            data.current &&
            data.current.us_aqi !== undefined
        ){

            const aqi =
            Math.round(
                data.current.us_aqi
            );


            document.getElementById(
                "aqiNumber"
            ).textContent =
            aqi;


            let status =
            "Good";


            if(aqi <= 50){

                status = "Good";

            }

            else if(aqi <= 100){

                status = "Moderate";

            }

            else if(aqi <= 150){

                status =
                "Unhealthy for Sensitive Groups";

            }

            else if(aqi <= 200){

                status = "Unhealthy";

            }

            else if(aqi <= 300){

                status = "Very Unhealthy";

            }

            else{

                status = "Hazardous";

            }


            document.getElementById(
                "aqiStatus"
            ).textContent =
            status;


            const percentage =
            Math.min(
                (aqi / 300) * 100,
                100
            );


            document.getElementById(
                "aqiMarker"
            ).style.left =
            percentage + "%";


            const number =
            document.getElementById(
                "aqiNumber"
            );


            if(aqi <= 50){

                number.style.color =
                "#57e65d";

            }

            else if(aqi <= 100){

                number.style.color =
                "#e6df32";

            }

            else if(aqi <= 150){

                number.style.color =
                "#ffae22";

            }

            else{

                number.style.color =
                "#ff4d4d";

            }

        }

    }

    catch(err){

        console.log(
            "AQI unavailable"
        );

    }

}



/* =====================================================
   SEARCH CITY
===================================================== */

async function searchWeather(){

    const city =
    cityInput.value.trim();


    if(!city){

        showError(
            "Please enter a city name."
        );

        return;

    }


    showLoading(true);


    try{

        const location =
        await searchCity(city);


        await getWeather(

            location.latitude,

            location.longitude,

            location.name,

            location.country_code

        );

    }

    catch(err){

        showError(
            err.message
        );

    }

    finally{

        showLoading(false);

    }

}



/* =====================================================
   CURRENT LOCATION
===================================================== */

function useMyLocation(){

    if(!navigator.geolocation){

        showError(
            "Geolocation is not supported by your browser."
        );

        return;

    }


    locationStatus.textContent =
    "Detecting your location...";


    navigator.geolocation.getCurrentPosition(

        async function(position){

            const latitude =
            position.coords.latitude;

            const longitude =
            position.coords.longitude;


            try{

                /*
                   Reverse geocoding using
                   Open-Meteo is not available,
                   so we use Nominatim here.
                */

                const response =
                await fetch(

                    `https://nominatim.openstreetmap.org/reverse?format=json&lat=${latitude}&lon=${longitude}`

                );


                const data =
                await response.json();


                const address =
                data.address || {};


                const city =

                address.city ||

                address.town ||

                address.village ||

                address.county ||

                "Your Location";


                const country =
                address.country_code
                ?
                address.country_code
                .toUpperCase()
                :
                "";


                await getWeather(

                    latitude,

                    longitude,

                    city,

                    country

                );

            }

            catch(error){

                await getWeather(

                    latitude,

                    longitude,

                    "Your Location",

                    ""

                );

            }

        },

        function(error){

            showError(
                "Location permission was denied. Please search for your city instead."
            );

            locationStatus.textContent =
            "Location unavailable";

        }

    );

}



/* =====================================================
   LOADING
===================================================== */

function showLoading(show){

    loading.style.display =
    show
    ?
    "block"
    :
    "none";

}



/* =====================================================
   ERROR
===================================================== */

function showError(message){

    errorBox.textContent =
    message;

    errorBox.style.display =
    "block";


    setTimeout(function(){

        errorBox.style.display =
        "none";

    },5000);

}



/* =====================================================
   EVENT LISTENERS
===================================================== */

searchBtn.addEventListener(
    "click",
    searchWeather
);


locationBtn.addEventListener(
    "click",
    useMyLocation
);


cityInput.addEventListener(
    "keypress",
    function(event){

        if(event.key === "Enter"){

            searchWeather();

        }

    }
);



